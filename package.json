{
  "name": "joymanga",
  "private": true,
  "version": "0.3.9",
  "type": "module",
  "description": "面向 Android 的漫画下载与本地阅读工具",
  "author": "Beyondoooars",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beyondoooars/JoyManga.git"
  },
  "homepage": "https://github.com/Beyondoooars/JoyManga#readme",
  "bugs": {
    "url": "https://github.com/Beyondoooars/JoyManga/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings --features bindings --locked --offline",
    "gen:icons": "tauri icon src-tauri/icons/icon-manifest.json -o src-tauri/icons",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:android": "node scripts/build-android.mjs --release",
    "build:android:debug": "node scripts/build-android.mjs --debug",
    "build:android:test": "node scripts/build-android.mjs --test",
    "bump": "node scripts/bump-version.mjs",
    "check": "pnpm exec eslint . && pnpm test && pnpm build && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@viselect/vue": "^3.10.1",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "unocss": "^0.63.0",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.3.1",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@11.16.0"
}
