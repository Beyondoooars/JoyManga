<?xml version="1.0" encoding="utf-8"?>
<!-- JoyManga 自适应图标前景：品牌粉 j + 青色页角。
     画布 108（自适应图标标准），字形按 48 设计稿缩放 1.28 并居中；
     白色机器人是 Tauri 模板残留，会让桌面显示成安卓机器人，替换为品牌标识。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="23.28"
        android:translateY="23.28"
        android:scaleX="1.28"
        android:scaleY="1.28">
        <!-- 青色菱形：翻起的页角 -->
        <group
            android:rotation="45"
            android:pivotX="30"
            android:pivotY="11.2">
            <path
                android:fillColor="#00AEEC"
                android:pathData="M26.6,5.4 H33.4 A2.4,2.4 0 0 1 35.8,7.8 V14.6 A2.4,2.4 0 0 1 33.4,17 H26.6 A2.4,2.4 0 0 1 24.2,14.6 V7.8 A2.4,2.4 0 0 1 26.6,5.4 Z" />
        </group>
        <!-- 品牌粉 j：字标主体，钩端圆头 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M30,21.5 V30 A9,9 0 0 1 13,30"
            android:strokeColor="#FB7299"
            android:strokeLineCap="round"
            android:strokeWidth="10" />
    </group>
</vector>
